# Скопируй в config.yaml и подправь под реальные параметры пагинации,
# которые видны в теле пойманного запроса (см. README, шаг "discover").
pagination_field: queryInput.pagination.offset # путь к полю offset внутри variables (через точку)
page_size: 48 # сколько товаров отдаёт один запрос (см. variables.queryInput.pagination.limit пойманного запроса)
max_pages: 40 # защита от бесконечного цикла
delay_seconds: 3 # вежливая пауза между запросами — не убирать
request_timeout: 20
